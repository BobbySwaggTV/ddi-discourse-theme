<div class="ddi-card ddi-restricted">

  <h2 class="ddi-card-title">
    DOCUMENT INTEGRITY VERIFICATION
  </h2>

  <div class="ddi-intel-grid">
    {{#each this.checks as |check|}}
      <div>
        <span>{{check.field}}</span>
        <strong class="ddi-integrity-{{check.statusClass}}">{{check.status}}</strong>
      </div>
    {{/each}}
  </div>

  {{#if this.warnings.length}}
    <div class="ddi-card-body">
      {{#each this.warnings as |warning|}}
        <div>{{warning.field}}: {{warning.detail}}</div>
      {{/each}}
    </div>
  {{/if}}

</div>
