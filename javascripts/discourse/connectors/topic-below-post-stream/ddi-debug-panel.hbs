<div class="ddi-card ddi-restricted">

  <h2 class="ddi-card-title">
    DDI DEBUG MODE
  </h2>

  <div class="ddi-intel-grid">

    <div>
      <span>Document ID</span>
      <strong>{{this.documentId}}</strong>
    </div>

    <div>
      <span>Topic ID</span>
      <strong>{{this.topicId}}</strong>
    </div>

    <div>
      <span>Category</span>
      <strong>{{this.category}}</strong>
    </div>

    <div>
      <span>Classification</span>
      <strong>{{this.classification}}</strong>
    </div>

    <div>
      <span>Detected Tags</span>
      <strong>{{this.detectedTags}}</strong>
    </div>

    <div>
      <span>Revision</span>
      <strong>{{this.revision}}</strong>
    </div>

    <div>
      <span>Word Count</span>
      <strong>{{this.wordCount}}</strong>
    </div>

    <div>
      <span>Reading Time</span>
      <strong>{{this.readingTime}} min</strong>
    </div>

  </div>

</div>
