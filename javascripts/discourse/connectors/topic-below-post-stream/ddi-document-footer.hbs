<div class="ddi-card {{this.classificationClass}}">

  <h2 class="ddi-card-title">
    DOCUMENT FOOTER
  </h2>

  <div class="ddi-intel-grid">

    <div>
      <span>Document Number</span>
      <strong>{{this.documentId}}</strong>
    </div>

    <div>
      <span>Classification</span>
      <strong>{{this.classification}}</strong>
    </div>

    <div>
      <span>Revision</span>
      <strong>{{this.revision}}</strong>
    </div>

    <div>
      <span>Department</span>
      <strong>{{this.department}}</strong>
    </div>

    <div>
      <span>Last Updated</span>
      <strong>{{this.lastUpdated}}</strong>
    </div>

    <div>
      <span>Author</span>
      <strong>{{this.author}}</strong>
    </div>

  </div>

  <div class="ddi-dossier-issued">
    End of Document
  </div>

</div>
