<div class="ddi-card">

  <div class="ddi-card-title">
    INTELLIGENCE NETWORK
  </div>

  {{#if this.isLoading}}
    <div class="ddi-card-body">
      SCANNING ARCHIVE…
    </div>
  {{else if this.relatedDocuments.length}}
    <div class="ddi-card-body">

      {{#each this.relatedDocuments as |doc|}}
        <a
         class="ddi-toc-item {{doc.classificationClass}}"
         href="{{doc.url}}"
        >
        <span class="ddi-toc-item-number">{{doc.documentId}}</span>

        <span class="ddi-toc-title">
            {{doc.title}}
        </span>
        </a>
      {{/each}}

    </div>
  {{else}}
    <div class="ddi-card-body">
      NO RELATED DOCUMENTS FOUND
    </div>
  {{/if}}

</div>
