<button type="button" class="ddi-integrity-trigger ddi-system-status-trigger" {{action "open"}}>
  System Status
</button>

<div class="ddi-command-palette-backdrop ddi-integrity-dashboard ddi-system-status-dashboard {{if this.isOpen "ddi-command-palette-open"}}">
  <div
    class="ddi-card ddi-integrity-dashboard-panel ddi-system-status-panel"
    {{did-insert this.setupModal}}
    {{did-update this.onOpenChange this.isOpen}}
    {{will-destroy this.teardownModal}}
  >

    <div class="ddi-card-title" id="ddi-system-status-title">
      DDI SYSTEM STATUS
    </div>

    {{#if this.isLoading}}
      <div class="ddi-card-body">
        SCANNING ARCHIVE…
      </div>
    {{else if this.status}}
      <div class="ddi-stat-grid">

        <div class="ddi-stat-tile ddi-stat-tile-total">
          <span>Total Documents</span>
          <strong>{{this.status.totalDocuments}}</strong>
        </div>

        <button
          type="button"
          class="ddi-stat-tile ddi-stat-tile-link"
          {{action "openIntegrityDashboard"}}
        >
          <span>Documents Missing Metadata</span>
          <strong>{{this.status.missingMetadata}}</strong>
        </button>

        <button
          type="button"
          class="ddi-stat-tile ddi-stat-tile-link"
          {{action "openIntegrityDashboard"}}
        >
          <span>Broken Cross References</span>
          <strong>{{this.status.brokenCrossReferences}}</strong>
        </button>

        <button
          type="button"
          class="ddi-stat-tile ddi-stat-tile-link"
          {{action "openIntegrityDashboard"}}
        >
          <span>Broken Related Documents</span>
          <strong>{{this.status.brokenRelatedDocuments}}</strong>
        </button>

        <button
          type="button"
          class="ddi-stat-tile ddi-stat-tile-link"
          {{action "openIntegrityDashboard"}}
        >
          <span>Duplicate Document Numbers</span>
          <strong>{{this.status.duplicateDocumentNumbers}}</strong>
        </button>

        <div class="ddi-stat-tile">
          <span>Draft Documents</span>
          <strong>{{this.status.draftDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Archived Documents</span>
          <strong>{{this.status.archivedDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Public Documents</span>
          <strong>{{this.status.publicDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Internal Documents</span>
          <strong>{{this.status.internalDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Restricted Documents</span>
          <strong>{{this.status.restrictedDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Top Secret Documents</span>
          <strong>{{this.status.topSecretDocuments}}</strong>
        </div>

      </div>
    {{else}}
      <div class="ddi-card-body">
        NO STATUS DATA AVAILABLE
      </div>
    {{/if}}

    <div class="ddi-favorites-actions">
      <button type="button" class="ddi-nav-link" {{action "close"}}>Close</button>
    </div>

  </div>
</div>
