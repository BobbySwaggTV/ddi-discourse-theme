<button type="button" class="ddi-integrity-trigger ddi-system-status-trigger" {{on "click" this.open}}>
  System Status
</button>

<div class="ddi-command-palette-backdrop ddi-integrity-dashboard ddi-system-status-dashboard {{if this.ddiSystemStatus.isOpen "ddi-command-palette-open"}}">
  <div
    class="ddi-card ddi-integrity-dashboard-panel ddi-system-status-panel"
    {{did-insert this.setupModal}}
    {{did-update this.onOpenChange this.ddiSystemStatus.isOpen}}
    {{will-destroy this.teardownModal}}
  >

    <h2 class="ddi-card-title" id="ddi-system-status-title">
      DDI SYSTEM STATUS
    </h2>

    {{#if this.ddiSystemStatus.isLoading}}
      <div class="ddi-card-body">
        SCANNING ARCHIVE…
      </div>
    {{else if this.ddiSystemStatus.status}}
      <div class="ddi-stat-grid">

        <div class="ddi-stat-tile ddi-stat-tile-total">
          <span>Total Documents</span>
          <strong>{{this.ddiSystemStatus.status.totalDocuments}}</strong>
        </div>

        <button
          type="button"
          class="ddi-stat-tile ddi-stat-tile-link"
          {{on "click" this.openIntegrityDashboard}}
        >
          <span>Documents Missing Metadata</span>
          <strong>{{this.ddiSystemStatus.status.missingMetadata}}</strong>
        </button>

        <button
          type="button"
          class="ddi-stat-tile ddi-stat-tile-link"
          {{on "click" this.openIntegrityDashboard}}
        >
          <span>Broken Cross References</span>
          <strong>{{this.ddiSystemStatus.status.brokenCrossReferences}}</strong>
        </button>

        <button
          type="button"
          class="ddi-stat-tile ddi-stat-tile-link"
          {{on "click" this.openIntegrityDashboard}}
        >
          <span>Broken Related Documents</span>
          <strong>{{this.ddiSystemStatus.status.brokenRelatedDocuments}}</strong>
        </button>

        <button
          type="button"
          class="ddi-stat-tile ddi-stat-tile-link"
          {{on "click" this.openIntegrityDashboard}}
        >
          <span>Duplicate Document Numbers</span>
          <strong>{{this.ddiSystemStatus.status.duplicateDocumentNumbers}}</strong>
        </button>

        <div class="ddi-stat-tile">
          <span>Draft Documents</span>
          <strong>{{this.ddiSystemStatus.status.draftDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Archived Documents</span>
          <strong>{{this.ddiSystemStatus.status.archivedDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Public Documents</span>
          <strong>{{this.ddiSystemStatus.status.publicDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Internal Documents</span>
          <strong>{{this.ddiSystemStatus.status.internalDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Restricted Documents</span>
          <strong>{{this.ddiSystemStatus.status.restrictedDocuments}}</strong>
        </div>

        <div class="ddi-stat-tile">
          <span>Top Secret Documents</span>
          <strong>{{this.ddiSystemStatus.status.topSecretDocuments}}</strong>
        </div>

      </div>
    {{else}}
      <div class="ddi-card-body">
        NO STATUS DATA AVAILABLE
      </div>
    {{/if}}

    <div class="ddi-favorites-actions">
      <button type="button" class="ddi-nav-link" {{on "click" this.close}}>Close</button>
    </div>

  </div>
</div>
