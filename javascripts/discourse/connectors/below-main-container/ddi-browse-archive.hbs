{{#if this.isVisible}}
  <div class="ddi-card ddi-browse-archive" id="ddi-browse-archive">

    <div class="ddi-card-title">
      BROWSE ARCHIVE
    </div>

    {{#if this.showTabs}}
      <div class="ddi-browse-archive-tabs" role="tablist" aria-label="Browse archive by">
        <button
          type="button"
          role="tab"
          id="ddi-browse-archive-tab-year"
          aria-selected={{if this.isYearTabActive "true" "false"}}
          aria-controls="ddi-browse-archive-panel-year"
          class="ddi-browse-archive-tab {{if this.isYearTabActive "ddi-browse-archive-tab-active"}}"
          {{on "click" (fn this.setTab "year")}}
        >
          By Year
        </button>
        <button
          type="button"
          role="tab"
          id="ddi-browse-archive-tab-index"
          aria-selected={{if this.isIndexTabActive "true" "false"}}
          aria-controls="ddi-browse-archive-panel-index"
          class="ddi-browse-archive-tab {{if this.isIndexTabActive "ddi-browse-archive-tab-active"}}"
          {{on "click" (fn this.setTab "index")}}
        >
          All Documents
        </button>
      </div>
    {{/if}}

    {{#if this.isLoading}}
      <div class="ddi-card-body">
        LOADING ARCHIVE…
      </div>
    {{else if this.isYearTabActive}}
      <div
        id="ddi-browse-archive-panel-year"
        role="tabpanel"
        aria-labelledby="ddi-browse-archive-tab-year"
      >
        {{#if this.years.length}}
          <div class="ddi-card-body">
            {{#each this.years as |entry|}}
              <div class="ddi-timeline-year">

                <button
                  type="button"
                  class="ddi-timeline-year-toggle"
                  {{on "click" (fn this.toggleYear entry.year)}}
                >
                  <span class="ddi-timeline-year-caret">{{if entry.isExpanded "−" "+"}}</span>
                  <span class="ddi-timeline-year-label">{{entry.year}}</span>
                  <span class="ddi-timeline-year-count">{{entry.documents.length}} Documents</span>
                </button>

                {{#if entry.isExpanded}}
                  <div class="ddi-timeline-year-body">
                    {{#each entry.documents as |doc|}}
                      <a
                       class="ddi-toc-item {{doc.classificationClass}}"
                       href="{{doc.url}}"
                      >
                      <div>
                        <span class="ddi-toc-title">
                            {{doc.title}}
                        </span>

                        <div class="ddi-dossier-grid ddi-favorites-grid">

                          <div>
                            <span>Document Number</span>
                            <strong>{{doc.documentId}}</strong>
                          </div>

                          <div>
                            <span>Document Type</span>
                            <strong>{{doc.documentTypeLabel}}</strong>
                          </div>

                          <div>
                            <span>Classification</span>
                            <strong>{{doc.classification}}</strong>
                          </div>

                          <div>
                            <span>Revision</span>
                            <strong>{{doc.revision}}</strong>
                          </div>

                          <div>
                            <span>Last Updated</span>
                            <strong>{{doc.updatedDate}}</strong>
                          </div>

                        </div>
                      </div>
                      </a>
                    {{/each}}
                  </div>
                {{/if}}

              </div>
            {{/each}}
          </div>
        {{else}}
          <div class="ddi-card-body">
            NO DOCUMENTS FOUND
          </div>
        {{/if}}
      </div>
    {{else if this.isIndexTabActive}}
      <div
        id="ddi-browse-archive-panel-index"
        role="tabpanel"
        aria-labelledby="ddi-browse-archive-tab-index"
      >
        {{#if this.documents.length}}
          <div class="ddi-card-body">
            {{#each this.documents as |doc|}}
              <a
               class="ddi-toc-item {{doc.classificationClass}}"
               href="{{doc.url}}"
              >
              <div>
                <span class="ddi-toc-title">
                    {{doc.title}}
                </span>

                <div class="ddi-dossier-grid">

                  <div>
                    <span>Document Number</span>
                    <strong>{{doc.documentId}}</strong>
                  </div>

                  <div>
                    <span>Department</span>
                    <strong>{{doc.department}}</strong>
                  </div>

                  <div>
                    <span>Classification</span>
                    <strong>{{doc.classification}}</strong>
                  </div>

                  <div>
                    <span>Revision</span>
                    <strong>{{doc.revision}}</strong>
                  </div>

                </div>
              </div>
              </a>
            {{/each}}
          </div>
        {{else}}
          <div class="ddi-card-body">
            NO DOCUMENTS FOUND
          </div>
        {{/if}}
      </div>
    {{/if}}

  </div>
{{/if}}
