{{#if this.isVisible}}
  <div class="ddi-card ddi-timeline-view">

    <div class="ddi-card-title">
      INTELLIGENCE TIMELINE
    </div>

    {{#if this.isLoading}}
      <div class="ddi-card-body">
        LOADING TIMELINE…
      </div>
    {{else if this.years.length}}
      <div class="ddi-card-body">

        {{#each this.years as |entry|}}
          <div class="ddi-timeline-year">

            <button
              type="button"
              class="ddi-timeline-year-toggle"
              {{action "toggleYear" entry.year}}
            >
              <span class="ddi-timeline-year-caret">{{if entry.isExpanded "−" "+"}}</span>
              <span class="ddi-timeline-year-label">{{entry.year}}</span>
              <span class="ddi-timeline-year-count">{{entry.documents.length}} Documents</span>
            </button>

            {{#if entry.isExpanded}}
              <div class="ddi-timeline-year-body">
                {{#each entry.documents as |doc|}}
                  <a
                   class="ddi-toc-item {{doc.classificationClass}}"
                   href="{{doc.url}}"
                  >
                  <div>
                    <span class="ddi-toc-title">
                        {{doc.title}}
                    </span>

                    <div class="ddi-dossier-grid ddi-favorites-grid">

                      <div>
                        <span>Document Number</span>
                        <strong>{{doc.documentId}}</strong>
                      </div>

                      <div>
                        <span>Document Type</span>
                        <strong>{{doc.documentTypeLabel}}</strong>
                      </div>

                      <div>
                        <span>Classification</span>
                        <strong>{{doc.classification}}</strong>
                      </div>

                      <div>
                        <span>Revision</span>
                        <strong>{{doc.revision}}</strong>
                      </div>

                      <div>
                        <span>Last Updated</span>
                        <strong>{{doc.updatedDate}}</strong>
                      </div>

                    </div>
                  </div>
                  </a>
                {{/each}}
              </div>
            {{/if}}

          </div>
        {{/each}}

      </div>
    {{else}}
      <div class="ddi-card-body">
        NO DOCUMENTS FOUND
      </div>
    {{/if}}

  </div>
{{/if}}
