<div class="ddi-card">

  <h2 class="ddi-card-title">
    REVISION HISTORY
  </h2>

  <div class="ddi-revision-table-wrap">
    <table class="ddi-revision-table">

      <caption class="ddi-revision-table-caption">{{this.revisionCountLabel}}</caption>

      <thead>
        <tr>
          <th scope="col">Revision</th>
          <th scope="col">Date</th>
          <th scope="col">Author</th>
          <th scope="col">Summary</th>
          <th scope="col">Approval Status</th>
        </tr>
      </thead>

      <tbody>
        {{#each this.revisions as |revision|}}
          <tr>
            <th scope="row">{{revision.revisionNumber}}</th>
            <td>{{revision.date}}</td>
            <td>{{revision.author}}</td>
            <td>{{revision.summary}}</td>
            <td>
              <span class="ddi-search-badge">{{revision.approvalStatus}}</span>
            </td>
          </tr>
        {{/each}}
      </tbody>

    </table>
  </div>

</div>
