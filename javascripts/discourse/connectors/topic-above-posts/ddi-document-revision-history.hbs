<div class="ddi-card">

  <div class="ddi-card-title">
    REVISION HISTORY
  </div>

  <div class="ddi-intel-grid">

    <div>
      <span>Revision Number</span>
      <strong>{{this.revisionNumber}}</strong>
    </div>

    <div>
      <span>Last Updated</span>
      <strong>{{this.lastUpdated}}</strong>
    </div>

    <div>
      <span>Author</span>
      <strong>{{this.author}}</strong>
    </div>

    <div>
      <span>Revision Status</span>
      <strong>{{this.revisionStatus}}</strong>
    </div>

  </div>

  <div class="ddi-card-body">
    {{this.revisionNotes}}
  </div>

</div>
